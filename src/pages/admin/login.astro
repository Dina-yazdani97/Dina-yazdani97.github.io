---
import Layout from '../../layouts/Layout.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';
import {
  ADMIN_USERNAME,
  ADMIN_PASSWORD,
  AUTH_COOKIE_NAME,
  createSessionToken,
  verifySessionToken,
} from '../../lib/auth';

let errorMessage = '';
const redirectUrl = Astro.url.searchParams.get('redirect') || '/keystatic';

// Check if already authenticated (Local dev only)
if (!import.meta.env.PROD) {
  const currentSession = Astro.cookies.get(AUTH_COOKIE_NAME);
  if (currentSession?.value && verifySessionToken(currentSession.value)) {
    return Astro.redirect(redirectUrl);
  }
}

// Handle Form Submission (Local dev only)
if (!import.meta.env.PROD && Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const username = (formData.get('username') as string)?.trim();
    const password = (formData.get('password') as string)?.trim();

    if (username === ADMIN_USERNAME && password === ADMIN_PASSWORD) {
      const token = createSessionToken(username);
      Astro.cookies.set(AUTH_COOKIE_NAME, token, {
        path: '/',
        httpOnly: true,
        sameSite: 'lax',
        secure: import.meta.env.PROD,
        maxAge: 60 * 60 * 24 * 7, // 7 days
      });
      return Astro.redirect(redirectUrl);
    } else {
      errorMessage = 'Invalid username or password. Please check your credentials.';
    }
  } catch (err) {
    errorMessage = 'An error occurred during sign-in. Please try again.';
  }
}
---

<Layout
  title="Admin Login | Keystatic CMS"
  description="Secure access to Dina Yazdani's Portfolio Content Management System."
  name="Dina Yazdani"
>
  <div class="min-h-screen flex flex-col justify-between bg-zinc-50 dark:bg-zinc-950 text-zinc-900 dark:text-zinc-100 transition-colors">
    
    <!-- Top Bar with Home Link & Theme Toggle -->
    <header class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex items-center justify-between">
      <a
        href="/"
        class="inline-flex items-center gap-2 text-xs sm:text-sm font-semibold text-zinc-600 dark:text-zinc-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        <span>Back to Website</span>
      </a>

      <ThemeToggle />
    </header>

    <!-- Main Login Card -->
    <main class="w-full max-w-md mx-auto px-4 py-8">
      <div class="relative p-8 rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-xl shadow-zinc-200/50 dark:shadow-black/60">
        
        <!-- Ambient subtle glow -->
        <div class="absolute -top-12 left-1/2 -translate-x-1/2 w-48 h-48 bg-emerald-500/15 blur-2xl rounded-full pointer-events-none -z-10"></div>

        <!-- Lock Icon Badge -->
        <div class="w-12 h-12 rounded-2xl bg-emerald-50 dark:bg-emerald-950/70 border border-emerald-200 dark:border-emerald-800 text-emerald-600 dark:text-emerald-400 flex items-center justify-center mx-auto mb-4 shadow-xs">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
        </div>

        <div class="text-center space-y-1 mb-6">
          <h1 class="text-2xl font-bold tracking-tight text-zinc-900 dark:text-white">
            Keystatic CMS Portal
          </h1>
          <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400">
            Enter administrator credentials to manage portfolio content
          </p>
        </div>

        <!-- Error Notification -->
        {errorMessage && (
          <div class="mb-5 p-3.5 rounded-2xl bg-rose-50 dark:bg-rose-950/50 border border-rose-200 dark:border-rose-800 text-rose-700 dark:text-rose-300 text-xs font-semibold flex items-center gap-2">
            <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>{errorMessage}</span>
          </div>
        )}

        <!-- Form -->
        <form method="POST" class="space-y-4">
          <div>
            <label for="username" class="block text-xs font-bold text-zinc-700 dark:text-zinc-300 uppercase tracking-wider mb-1.5">
              Username
            </label>
            <div class="relative">
              <input
                id="username"
                name="username"
                type="text"
                required
                autocomplete="username"
                placeholder="Admin username"
                class="w-full px-4 py-2.5 rounded-xl text-sm bg-zinc-50 dark:bg-zinc-800/80 border border-zinc-200 dark:border-zinc-700 text-zinc-900 dark:text-white placeholder-zinc-400 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent transition-all"
              />
            </div>
          </div>

          <div>
            <label for="password" class="block text-xs font-bold text-zinc-700 dark:text-zinc-300 uppercase tracking-wider mb-1.5">
              Password
            </label>
            <div class="relative">
              <input
                id="password"
                name="password"
                type="password"
                required
                autocomplete="current-password"
                placeholder="••••••••••••"
                class="w-full px-4 py-2.5 rounded-xl text-sm bg-zinc-50 dark:bg-zinc-800/80 border border-zinc-200 dark:border-zinc-700 text-zinc-900 dark:text-white placeholder-zinc-400 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent transition-all"
              />
            </div>
          </div>

          <button
            type="submit"
            class="w-full mt-2 py-3 px-4 rounded-xl font-bold text-sm text-white bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-700 hover:to-teal-700 shadow-md shadow-emerald-600/25 transition-all transform hover:-translate-y-0.5 active:translate-y-0 cursor-pointer"
          >
            Sign In to CMS
          </button>
        </form>

        <div class="mt-6 pt-5 border-t border-zinc-100 dark:border-zinc-800 text-center">
          <p class="text-[11px] text-zinc-400 dark:text-zinc-500">
            Protected session with encrypted HTTP-only authentication cookie.
          </p>
        </div>

      </div>
    </main>

    <!-- Bottom Footer Note -->
    <footer class="py-6 text-center text-xs text-zinc-400 dark:text-zinc-500">
      © {new Date().getFullYear()} Dina Yazdani Portfolio Administration
    </footer>

  </div>
</Layout>
