---
import type { ProfileData } from '../lib/data';

interface Props {
  profile: ProfileData;
}

const { profile } = Astro.props;
---

<section class="relative pt-12 pb-16 md:pt-20 md:pb-24 overflow-hidden border-b border-zinc-200/70 dark:border-zinc-800/70">
  <!-- Ambient background glow effects for climate theme -->
  <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[700px] h-[350px] bg-gradient-to-tr from-emerald-500/15 via-teal-500/10 to-cyan-500/15 blur-3xl -z-10 pointer-events-none rounded-full"></div>
  <div class="absolute top-1/2 -right-40 w-96 h-96 bg-teal-500/10 blur-3xl -z-10 pointer-events-none rounded-full"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">

      <!-- Left / Main Column -->
      <div class="lg:col-span-8 flex flex-col items-start space-y-6">

        <!-- Status Pill -->
        {profile.statusBadge && (
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-semibold bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/80 shadow-xs">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>{profile.statusBadge}</span>
          </div>
        )}

        <!-- Name & Headline -->
        <div class="space-y-3">
          <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-zinc-900 dark:text-white">
            {profile.name}
          </h1>
          <p class="text-xl sm:text-2xl font-semibold bg-gradient-to-r from-emerald-600 via-teal-600 to-cyan-600 dark:from-emerald-400 dark:via-teal-300 dark:to-cyan-400 bg-clip-text text-transparent">
            {profile.headline}
          </p>
        </div>

        <!-- Personal / Academic Contact Pills -->
        <div class="flex flex-wrap gap-2 sm:gap-3 text-xs sm:text-sm text-zinc-600 dark:text-zinc-300">
          <!-- Location -->
          <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-zinc-100 dark:bg-zinc-800/70 border border-zinc-200 dark:border-zinc-700/60">
            <svg class="w-4 h-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>{profile.location}</span>
          </div>

          <!-- Email -->
          <a
            href={`mailto:${profile.email}`}
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-zinc-100 dark:bg-zinc-800/70 border border-zinc-200 dark:border-zinc-700/60 hover:text-emerald-600 dark:hover:text-emerald-400 hover:border-emerald-300 dark:hover:border-emerald-700 transition-colors"
          >
            <svg class="w-4 h-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <span>{profile.email}</span>
          </a>

          <!-- Phone -->
          <a
            href={`tel:${profile.phone.replace(/[^0-9+]/g, '')}`}
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-zinc-100 dark:bg-zinc-800/70 border border-zinc-200 dark:border-zinc-700/60 hover:text-emerald-600 dark:hover:text-emerald-400 hover:border-emerald-300 dark:hover:border-emerald-700 transition-colors"
          >
            <svg class="w-4 h-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <span>{profile.phone}</span>
          </a>

          <!-- Languages -->
          <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-zinc-100 dark:bg-zinc-800/70 border border-zinc-200 dark:border-zinc-700/60">
            <svg class="w-4 h-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
            </svg>
            <span>{profile.englishLevel} · {profile.persianLevel}</span>
          </div>
        </div>

        <!-- Academic & Scientific Links -->
        <div class="flex flex-wrap items-center gap-3 pt-2">
          {profile.linkedin && (
            <a
              href={profile.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-semibold bg-white dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-700 hover:border-emerald-500 dark:hover:border-emerald-500 text-zinc-800 dark:text-zinc-200 shadow-xs hover:shadow-md transition-all"
            >
              <svg class="w-4 h-4 text-[#0A66C2]" fill="currentColor" viewBox="0 0 24 24">
                <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 8.76c-.97 0-1.75-.79-1.75-1.76s.78-1.75 1.75-1.75c.97 0 1.76.78 1.76 1.75s-.79 1.76-1.76 1.76m1.37 9.74v-8.37H5.1v8.37h2.73z" />
              </svg>
              <span>LinkedIn</span>
            </a>
          )}

          {profile.github && (
            <a
              href={profile.github}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-semibold bg-white dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-700 hover:border-emerald-500 dark:hover:border-emerald-500 text-zinc-800 dark:text-zinc-200 shadow-xs hover:shadow-md transition-all"
            >
              <svg class="w-4 h-4 text-zinc-800 dark:text-white" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
              </svg>
              <span>GitHub</span>
            </a>
          )}

          {profile.orcid && (
            <a
              href={profile.orcid}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-semibold bg-white dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-700 hover:border-emerald-500 dark:hover:border-emerald-500 text-zinc-800 dark:text-zinc-200 shadow-xs hover:shadow-md transition-all"
            >
              <span class="w-4 h-4 rounded-full bg-[#A6CE39] text-white flex items-center justify-center font-bold text-[9px]">iD</span>
              <span>ORCID</span>
            </a>
          )}

          {profile.researchgate && (
            <a
              href={profile.researchgate}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-semibold bg-white dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-700 hover:border-emerald-500 dark:hover:border-emerald-500 text-zinc-800 dark:text-zinc-200 shadow-xs hover:shadow-md transition-all"
            >
              <span class="w-4 h-4 rounded-sm bg-[#00CCBB] text-white flex items-center justify-center font-black text-[9px]">RG</span>
              <span>ResearchGate</span>
            </a>
          )}

          {profile.googleScholar && (
            <a
              href={profile.googleScholar}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Google Scholar"
              class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-semibold bg-white dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-700 hover:border-emerald-500 dark:hover:border-emerald-500 text-zinc-800 dark:text-zinc-200 shadow-xs hover:shadow-md transition-all"
            >
              <svg
                class="w-4 h-4 text-[#4285F4]"
                fill="currentColor"
                viewBox="0 0 512 512"
                aria-hidden="true"
              >
                <path d="M390.9 298.5s0 .1.1.1c9.2 19.4 14.4 41.1 14.4 64C405.3 445.1 338.5 512 256 512s-149.3-66.9-149.3-149.3c0-22.9 5.2-44.6 14.4-64c1.7-3.6 3.6-7.2 5.6-10.7q6.6-11.4 15-21.3c27.4-32.6 68.5-53.3 114.4-53.3c33.6 0 64.6 11.1 89.6 29.9c9.1 6.9 17.4 14.7 24.8 23.5c5.6 6.6 10.6 13.8 15 21.3c2 3.4 3.8 7 5.5 10.5zm26.4-18.8c-30.1-58.4-91-98.4-161.3-98.4s-131.2 40-161.3 98.4L0 202.7L256 0l256 202.7l-94.7 77.1z"/>
              </svg>
              <span>Google Scholar</span>
            </a>
          )}
        </div>

        <!-- Action CTA Buttons -->
        <div class="flex flex-wrap items-center gap-3 pt-4">
          <a
            href="#publications"
            class="px-5 py-2.5 rounded-xl font-semibold text-sm text-white bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-700 hover:to-teal-700 shadow-md shadow-emerald-600/25 transition-all transform hover:-translate-y-0.5"
          >
            Explore Publications
          </a>
          <a
            href="#experience"
            class="px-5 py-2.5 rounded-xl font-semibold text-sm text-zinc-800 dark:text-zinc-200 bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 transition-colors"
          >
            View Experience
          </a>
          <a
            href="#contact"
            class="px-5 py-2.5 rounded-xl font-semibold text-sm text-emerald-700 dark:text-emerald-300 bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200 dark:border-emerald-800 hover:bg-emerald-100 dark:hover:bg-emerald-900/60 transition-colors"
          >
            Contact & Inquiries
          </a>
        </div>

      </div>

      <!-- Right Column: Stats Cards Grid -->
      <div class="lg:col-span-4">
        <div class="relative bg-gradient-to-b from-white to-zinc-50 dark:from-zinc-900 dark:to-zinc-950 p-6 rounded-3xl border border-zinc-200 dark:border-zinc-800 shadow-xl shadow-zinc-200/50 dark:shadow-black/40">

          <div class="flex items-center justify-between pb-4 border-b border-zinc-100 dark:border-zinc-800/80">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-emerald-500"></span>
              <span class="text-xs font-bold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">Academic Standing</span>
            </div>
            <span class="text-xs font-medium text-emerald-600 dark:text-emerald-400">Verified Credentials</span>
          </div>

          <div class="grid grid-cols-2 gap-4 pt-5">
            {profile.stats.map((stat) => (
              <div class="p-3.5 rounded-2xl bg-white dark:bg-zinc-800/60 border border-zinc-100 dark:border-zinc-700/50">
                <div class="text-2xl font-extrabold text-zinc-900 dark:text-white tracking-tight text-emerald-600 dark:text-emerald-400">
                  {stat.value}
                </div>
                <div class="text-xs font-semibold text-zinc-700 dark:text-zinc-300 mt-1">
                  {stat.label}
                </div>
                <div class="text-[11px] text-zinc-500 dark:text-zinc-400 mt-0.5 leading-snug">
                  {stat.detail}
                </div>
              </div>
            ))}
          </div>

          <!-- Highlight Box: IPCC AR7 & CMIP Community -->
          <div class="mt-4 p-4 rounded-2xl bg-gradient-to-r from-emerald-500/10 via-teal-500/10 to-cyan-500/10 border border-emerald-500/20">
            <div class="flex items-center gap-2 text-xs font-bold text-emerald-800 dark:text-emerald-300">
              <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
              <span>International Expert Reviewer</span>
            </div>
            <p class="text-xs text-zinc-600 dark:text-zinc-300 mt-1.5 leading-relaxed">
              Evaluating the scientific accuracy, completeness, and balance of IPCC AR7 Working Group I First Order Draft.
            </p>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>
