---
interface Props {
  name: string;
}

const { name } = Astro.props;
---

<footer class="py-12 bg-white dark:bg-zinc-950 border-t border-zinc-200 dark:border-zinc-800 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6">
      
      <!-- Left: Copyright & Name -->
      <div class="flex flex-col items-center md:items-start space-y-1">
        <div class="flex items-center gap-2">
          <div class="w-6 h-6 rounded-lg bg-gradient-to-tr from-emerald-600 to-teal-500 flex items-center justify-center text-white font-bold text-xs">
            DY
          </div>
          <span class="font-bold text-zinc-900 dark:text-white text-sm">
            {name}
          </span>
        </div>
        <p class="text-xs text-zinc-500 dark:text-zinc-400">
          Climatologist, Climate & Earth System Modeler, Machine Learning Researcher.
        </p>
      </div>

      <!-- Center: Stack Badges -->
      <div class="flex flex-wrap items-center justify-center gap-2 text-xs text-zinc-500 dark:text-zinc-400">
        <span class="px-2.5 py-1 rounded-lg bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 font-medium">
          Astro
        </span>
        <span class="px-2.5 py-1 rounded-lg bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 font-medium">
          Keystatic CMS
        </span>
        <span class="px-2.5 py-1 rounded-lg bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 font-medium">
          Tailwind CSS
        </span>
      </div>

      <!-- Right: Scroll to top -->
      <div class="flex items-center gap-4 text-xs font-semibold">
        <button
          onclick="window.scrollTo({top: 0, behavior: 'smooth'})"
          class="text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white transition-colors cursor-pointer"
        >
          Back to Top ↑
        </button>
      </div>

    </div>

    <div class="mt-8 pt-6 border-t border-zinc-100 dark:border-zinc-900 text-center text-[11px] text-zinc-400 dark:text-zinc-500">
      © {new Date().getFullYear()} {name}. All rights reserved.
    </div>
  </div>
</footer>
