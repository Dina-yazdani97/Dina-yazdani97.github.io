---
import type { ExperienceItem } from '../lib/data';

interface Props {
  experiences: ExperienceItem[];
}

const { experiences } = Astro.props;
---

<section id="experience" class="py-16 md:py-24 border-b border-zinc-200/70 dark:border-zinc-800/70">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider text-emerald-700 dark:text-emerald-300 bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200 dark:border-emerald-800">
        Professional & Research Career
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-zinc-900 dark:text-white tracking-tight mt-3">
        Work & Research Experience
      </h2>
      <p class="text-base text-zinc-600 dark:text-zinc-400 mt-2">
        Bridging academic research, automated climate pipelines, machine learning internships, geospatial cartography, and community instruction.
      </p>
    </div>

    <!-- Timeline Container -->
    <div class="mt-12 relative border-l-2 border-emerald-500/20 dark:border-emerald-500/30 ml-4 sm:ml-8 space-y-10 pl-6 sm:pl-10">
      {experiences.map((exp) => (
        <div class="relative group">
          
          <!-- Timeline Indicator Node -->
          <div class="absolute -left-[31px] sm:-left-[47px] top-1.5 w-4 h-4 sm:w-5 sm:h-5 rounded-full bg-white dark:bg-zinc-950 border-4 border-emerald-500 group-hover:scale-125 transition-transform duration-200 shadow-sm"></div>

          <!-- Card Content -->
          <div class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200/80 dark:border-zinc-800 shadow-xs hover:border-emerald-500/40 dark:hover:border-emerald-500/40 hover:shadow-lg transition-all duration-300">
            
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-3 border-b border-zinc-100 dark:border-zinc-800">
              <div>
                <span class="inline-block px-2.5 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wider bg-emerald-50 dark:bg-emerald-950/70 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/80 mb-1.5">
                  {exp.category}
                </span>
                <h3 class="text-xl sm:text-2xl font-bold text-zinc-900 dark:text-white tracking-tight">
                  {exp.role}
                </h3>
                <div class="text-sm font-semibold text-emerald-600 dark:text-emerald-400 mt-0.5">
                  {exp.organization}
                  {exp.location && (
                    <span class="font-normal text-zinc-500 dark:text-zinc-400"> · {exp.location}</span>
                  )}
                </div>
              </div>

              <!-- Period Pill -->
              <div class="self-start sm:self-auto shrink-0 px-3 py-1 rounded-xl text-xs font-semibold bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300">
                {exp.period}
              </div>
            </div>

            <!-- Bullet Highlights -->
            <ul class="mt-4 space-y-2.5">
              {exp.highlights.map((bullet) => (
                <li class="flex items-start gap-3 text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed">
                  <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-emerald-500 shrink-0"></span>
                  <span>{bullet}</span>
                </li>
              ))}
            </ul>

            <!-- External Reference Link if available -->
            {exp.linkUrl && (
              <div class="mt-5 pt-4 border-t border-zinc-100 dark:border-zinc-800 flex justify-end">
                <a
                  href={exp.linkUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-600 dark:text-emerald-400 hover:text-emerald-700 dark:hover:text-emerald-300 transition-colors"
                >
                  <span>{exp.linkLabel || 'View Reference'}</span>
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </a>
              </div>
            )}

          </div>

        </div>
      ))}
    </div>

  </div>
</section>
