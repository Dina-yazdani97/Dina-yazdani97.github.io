---
import type { ProfileData } from '../lib/data';

interface Props {
  profile: ProfileData;
}

const { profile } = Astro.props;
---

<section id="contact" class="py-16 md:py-24 border-b border-zinc-200/70 dark:border-zinc-800/70 bg-gradient-to-b from-transparent to-zinc-100/60 dark:to-zinc-950/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
      
      <!-- Left Column: Inquiries & Contact Info -->
      <div class="lg:col-span-7 space-y-6">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider text-emerald-700 dark:text-emerald-300 bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200 dark:border-emerald-800">
          Get in Touch
        </div>

        <h2 class="text-3xl sm:text-4xl font-extrabold text-zinc-900 dark:text-white tracking-tight">
          Let’s Collaborate on Climate, Earth Observation & AI
        </h2>

        <p class="text-base text-zinc-600 dark:text-zinc-400 leading-relaxed max-w-xl">
          I am actively seeking prospective PhD positions, international research partnerships, and data science collaborations in climate dynamics and Earth system modeling. Feel free to reach out via email or connect on academic networks.
        </p>

        <!-- Direct Contact Info Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
          
          <!-- Email Box -->
          <a
            href={`mailto:${profile.email}`}
            class="group p-5 rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hover:border-emerald-500/50 shadow-xs transition-colors flex items-center gap-4"
          >
            <div class="w-12 h-12 rounded-2xl bg-emerald-50 dark:bg-emerald-950/60 flex items-center justify-center text-emerald-600 dark:text-emerald-400 shrink-0 group-hover:scale-105 transition-transform">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div class="min-w-0">
              <div class="text-xs font-semibold text-zinc-500 dark:text-zinc-400">Direct Email</div>
              <div class="text-sm font-bold text-zinc-900 dark:text-white truncate group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
                {profile.email}
              </div>
            </div>
          </a>

          <!-- Phone Box -->
          <a
            href={`tel:${profile.phone.replace(/[^0-9+]/g, '')}`}
            class="group p-5 rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hover:border-emerald-500/50 shadow-xs transition-colors flex items-center gap-4"
          >
            <div class="w-12 h-12 rounded-2xl bg-teal-50 dark:bg-teal-950/60 flex items-center justify-center text-teal-600 dark:text-teal-400 shrink-0 group-hover:scale-105 transition-transform">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <div class="min-w-0">
              <div class="text-xs font-semibold text-zinc-500 dark:text-zinc-400">Phone / WhatsApp</div>
              <div class="text-sm font-bold text-zinc-900 dark:text-white truncate group-hover:text-teal-600 dark:group-hover:text-teal-400 transition-colors">
                {profile.phone}
              </div>
            </div>
          </a>

        </div>

        <!-- Academic Network Buttons -->
        <div class="flex flex-wrap items-center gap-3 pt-2">
          {profile.linkedin && (
            <a
              href={profile.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="px-4 py-2 rounded-xl text-xs font-semibold bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hover:border-emerald-500 text-zinc-800 dark:text-zinc-200 shadow-xs transition-colors"
            >
              LinkedIn Profile ↗
            </a>
          )}
          {profile.github && (
            <a
              href={profile.github}
              target="_blank"
              rel="noopener noreferrer"
              class="px-4 py-2 rounded-xl text-xs font-semibold bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hover:border-emerald-500 text-zinc-800 dark:text-zinc-200 shadow-xs transition-colors"
            >
              GitHub Repositories ↗
            </a>
          )}
          {profile.orcid && (
            <a
              href={profile.orcid}
              target="_blank"
              rel="noopener noreferrer"
              class="px-4 py-2 rounded-xl text-xs font-semibold bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hover:border-emerald-500 text-zinc-800 dark:text-zinc-200 shadow-xs transition-colors"
            >
              ORCID Record ↗
            </a>
          )}
          {profile.researchgate && (
            <a
              href={profile.researchgate}
              target="_blank"
              rel="noopener noreferrer"
              class="px-4 py-2 rounded-xl text-xs font-semibold bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hover:border-emerald-500 text-zinc-800 dark:text-zinc-200 shadow-xs transition-colors"
            >
              ResearchGate Profile ↗
            </a>
          )}
        </div>

      </div>

      <!-- Right Column: Academic Opportunities Card -->
      <div class="lg:col-span-5">
        <div class="p-8 rounded-3xl bg-gradient-to-br from-emerald-500/10 via-teal-500/5 to-cyan-500/10 border border-emerald-500/20 dark:border-emerald-500/30 shadow-lg space-y-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-emerald-600 text-white">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
            <span>Research Opportunities</span>
          </div>

          <h3 class="text-xl font-bold text-zinc-900 dark:text-white">
            Open for Prospective PhD Positions & Partnerships
          </h3>

          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed">
            Interested in doctoral opportunities, joint publications, and applied projects in the following domains:
          </p>

          <ul class="space-y-2 text-xs sm:text-sm text-zinc-700 dark:text-zinc-200">
            <li class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 shrink-0"></span>
              <span>CMIP6/CMIP7 Evaluation & DAMIP Climate Forcings</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 shrink-0"></span>
              <span>Machine Learning & Deep Learning for Climate Extremes</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 shrink-0"></span>
              <span>Statistical Downscaling & Uncertainty Quantification</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 shrink-0"></span>
              <span>Earth Observation, Satellite Remote Sensing & GIS</span>
            </li>
          </ul>

          <div class="pt-3">
            <a
              href={`mailto:${profile.email}?subject=Research%20Collaboration%20Inquiry`}
              class="inline-flex items-center justify-center gap-2 w-full px-5 py-3 rounded-2xl font-bold text-sm text-white bg-emerald-600 hover:bg-emerald-700 shadow-md shadow-emerald-600/30 transition-all transform hover:-translate-y-0.5"
            >
              <span>Send Research Inquiry</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>
