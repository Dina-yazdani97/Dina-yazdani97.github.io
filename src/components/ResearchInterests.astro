---
import type { ProfileData, ResearchInterest } from '../lib/data';

interface Props {
  profile: ProfileData;
  interests: ResearchInterest[];
}

const { profile, interests } = Astro.props;

// Map icon names to inline SVGs
const getIcon = (name: string) => {
  switch (name) {
    case 'Cpu':
      return `<svg class="w-6 h-6 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="4" y="4" width="16" height="16" rx="2" /><rect x="9" y="9" width="6" height="6" /><path d="M9 1v3M15 1v3M9 20v3M15 20v3M20 9h3M20 14h3M1 9h3M1 14h3" /></svg>`;
    case 'Sun':
      return `<svg class="w-6 h-6 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>`;
    case 'Globe':
      return `<svg class="w-6 h-6 text-sky-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>`;
    case 'Flame':
      return `<svg class="w-6 h-6 text-rose-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z" /></svg>`;
    case 'BarChart3':
      return `<svg class="w-6 h-6 text-indigo-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M3 3v18h18M18 17V9M13 17V5M8 17v-3"/></svg>`;
    case 'Satellite':
    default:
      return `<svg class="w-6 h-6 text-teal-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>`;
  }
};
---

<section id="about" class="py-16 md:py-24 border-b border-zinc-200/70 dark:border-zinc-800/70">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Title -->
    <div class="max-w-3xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider text-emerald-700 dark:text-emerald-300 bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200 dark:border-emerald-800">
        Research Profile & Bio
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-zinc-900 dark:text-white tracking-tight mt-3">
        Advancing Climate Science with Earth Observation & Machine Learning
      </h2>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400 mt-2">
        A deep dive into model uncertainty, systematic biases, climate forcings, and high-performance reproducible analytical pipelines.
      </p>
    </div>

    <!-- Bio Narrative Grid -->
    <div class="mt-10 grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="p-6 rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-xs flex flex-col justify-between">
        <div>
          <div class="w-10 h-10 rounded-2xl bg-emerald-50 dark:bg-emerald-950/60 flex items-center justify-center text-emerald-600 dark:text-emerald-400 font-bold mb-4">
            01
          </div>
          <h3 class="text-lg font-bold text-zinc-900 dark:text-white mb-2">
            Climate Modeling & Ensembles
          </h3>
          <p class="text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed">
            {profile.bioParagraph1}
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-zinc-100 dark:border-zinc-800 text-xs font-semibold text-emerald-600 dark:text-emerald-400">
          CMIP5 · CMIP6 · DAMIP Experiments
        </div>
      </div>

      <div class="p-6 rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-xs flex flex-col justify-between">
        <div>
          <div class="w-10 h-10 rounded-2xl bg-teal-50 dark:bg-teal-950/60 flex items-center justify-center text-teal-600 dark:text-teal-400 font-bold mb-4">
            02
          </div>
          <h3 class="text-lg font-bold text-zinc-900 dark:text-white mb-2">
            Automated Analytics & ML
          </h3>
          <p class="text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed">
            {profile.bioParagraph2}
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-zinc-100 dark:border-zinc-800 text-xs font-semibold text-teal-600 dark:text-teal-400">
          Python · R · Scikit-learn · Deep Learning
        </div>
      </div>

      <div class="p-6 rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-xs flex flex-col justify-between">
        <div>
          <div class="w-10 h-10 rounded-2xl bg-cyan-50 dark:bg-cyan-950/60 flex items-center justify-center text-cyan-600 dark:text-cyan-400 font-bold mb-4">
            03
          </div>
          <h3 class="text-lg font-bold text-zinc-900 dark:text-white mb-2">
            Future Research Vision
          </h3>
          <p class="text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed">
            {profile.bioParagraph3}
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-zinc-100 dark:border-zinc-800 text-xs font-semibold text-cyan-600 dark:text-cyan-400">
          Earth Observation · Extremes · Spatial AI
        </div>
      </div>
    </div>

    <!-- Research Interests Grid -->
    <div id="research" class="mt-16">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 gap-4">
        <div>
          <h3 class="text-2xl font-bold text-zinc-900 dark:text-white tracking-tight">
            Key Research Focus Areas
          </h3>
          <p class="text-sm text-zinc-600 dark:text-zinc-400 mt-1">
            Core theoretical and empirical investigations in modern climatology and computational data science.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {interests.map((interest) => (
          <div class="group p-6 rounded-3xl bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200/80 dark:border-zinc-800 hover:border-emerald-500/50 dark:hover:border-emerald-500/50 hover:bg-white dark:hover:bg-zinc-900 transition-all duration-300 shadow-xs hover:shadow-lg hover:shadow-emerald-500/5">
            <div class="flex items-center justify-between mb-4">
              <div class="p-3 rounded-2xl bg-white dark:bg-zinc-800 border border-zinc-100 dark:border-zinc-700 shadow-xs group-hover:scale-110 transition-transform">
                <Fragment set:html={getIcon(interest.icon)} />
              </div>
              <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-zinc-200/70 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300">
                {interest.tag}
              </span>
            </div>

            <h4 class="text-base font-bold text-zinc-900 dark:text-white group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
              {interest.title}
            </h4>
            <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 mt-2 leading-relaxed">
              {interest.description}
            </p>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
