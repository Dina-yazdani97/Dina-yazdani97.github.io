---
import type { EducationItem, AwardItem, ServiceItem } from '../lib/data';

interface Props {
  education: EducationItem[];
  awards: AwardItem[];
  services: ServiceItem[];
}

const { education, awards, services } = Astro.props;
---

<section id="education" class="py-16 md:py-24 border-b border-zinc-200/70 dark:border-zinc-800/70">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      
      <!-- Left Column: Education & Professional Service -->
      <div class="lg:col-span-6 space-y-12">
        
        <!-- Education -->
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider text-emerald-700 dark:text-emerald-300 bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200 dark:border-emerald-800 mb-4">
            Academic Background
          </div>
          <h2 class="text-3xl font-extrabold text-zinc-900 dark:text-white tracking-tight">
            Education & Degrees
          </h2>

          <div class="mt-6 space-y-6">
            {education.map((edu) => (
              <div class="p-6 rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200/80 dark:border-zinc-800 shadow-xs hover:border-emerald-500/40 transition-colors">
                <div class="flex items-start justify-between gap-4">
                  <div>
                    <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-50 dark:bg-emerald-950/70 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800 mb-2">
                      {edu.rankBadge}
                    </span>
                    <h3 class="text-xl font-bold text-zinc-900 dark:text-white">
                      {edu.degree}
                    </h3>
                    <div class="text-sm font-semibold text-zinc-600 dark:text-zinc-300 mt-1">
                      {edu.institution}
                      {edu.location && (
                        <span class="font-normal text-zinc-500 dark:text-zinc-400"> · {edu.location}</span>
                      )}
                    </div>
                  </div>
                  <div class="text-right shrink-0">
                    <span class="px-3 py-1 rounded-xl text-xs font-semibold bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300">
                      {edu.period}
                    </span>
                    <div class="text-xs font-bold text-emerald-600 dark:text-emerald-400 mt-2">
                      GPA: {edu.gpa}
                    </div>
                  </div>
                </div>

                {edu.thesis && (
                  <div class="mt-4 pt-4 border-t border-zinc-100 dark:border-zinc-800 text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed italic">
                    "{edu.thesis}"
                  </div>
                )}
              </div>
            ))}
          </div>
        </div>

        <!-- Professional Service & Reviewing -->
        <div id="service">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider text-cyan-700 dark:text-cyan-300 bg-cyan-50 dark:bg-cyan-950/60 border border-cyan-200 dark:border-cyan-800 mb-4">
            Scientific Review & Global Impact
          </div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-zinc-900 dark:text-white tracking-tight">
            Professional Service
          </h2>

          <div class="mt-6 space-y-4">
            {services.map((srv) => (
              <div class="p-6 rounded-3xl bg-gradient-to-br from-white to-zinc-50 dark:from-zinc-900 dark:to-zinc-950 border border-zinc-200 dark:border-zinc-800 shadow-xs">
                <div class="flex items-center justify-between gap-4 mb-2">
                  <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-cyan-50 dark:bg-cyan-950 text-cyan-700 dark:text-cyan-300 border border-cyan-200 dark:border-cyan-800">
                    {srv.badge}
                  </span>
                  <span class="text-xs font-semibold text-zinc-500 dark:text-zinc-400">
                    {srv.date}
                  </span>
                </div>
                <h3 class="text-lg font-bold text-zinc-900 dark:text-white">
                  {srv.role}
                </h3>
                <div class="text-sm font-semibold text-emerald-600 dark:text-emerald-400">
                  {srv.organization}
                </div>
                <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 mt-3 leading-relaxed">
                  {srv.description}
                </p>
              </div>
            ))}
          </div>
        </div>

      </div>

      <!-- Right Column: Honors & Awards -->
      <div id="awards" class="lg:col-span-6">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider text-amber-700 dark:text-amber-300 bg-amber-50 dark:bg-amber-950/60 border border-amber-200 dark:border-amber-800 mb-4">
          Distinctions & Recognition
        </div>
        <h2 class="text-3xl font-extrabold text-zinc-900 dark:text-white tracking-tight">
          Honors & Awards
        </h2>
        <p class="text-sm text-zinc-600 dark:text-zinc-400 mt-2">
          Recognitions for valedictorian academic performance, research productivity, and national modular origami mastery.
        </p>

        <div class="mt-6 space-y-4">
          {awards.map((award) => (
            <div class="group p-5 rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200/80 dark:border-zinc-800 shadow-xs hover:border-amber-400/50 dark:hover:border-amber-500/50 transition-all duration-200">
              <div class="flex items-start justify-between gap-4">
                <div class="space-y-1">
                  <div class="flex items-center gap-2">
                    <span class="w-6 h-6 rounded-lg bg-amber-50 dark:bg-amber-950 flex items-center justify-center text-amber-600 dark:text-amber-400 font-bold text-xs">
                      ★
                    </span>
                    <span class="px-2 py-0.5 rounded-full text-[11px] font-bold bg-amber-50 dark:bg-amber-950/70 text-amber-700 dark:text-amber-300 border border-amber-200 dark:border-amber-800">
                      {award.badge}
                    </span>
                    <span class="text-xs font-bold text-zinc-500 dark:text-zinc-400">
                      {award.year}
                    </span>
                  </div>

                  <h3 class="text-base font-bold text-zinc-900 dark:text-white pt-1 group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors">
                    {award.title}
                  </h3>
                  
                  <div class="text-xs font-semibold text-zinc-500 dark:text-zinc-400">
                    {award.institution}
                  </div>
                </div>
              </div>

              {award.details && (
                <p class="text-xs text-zinc-600 dark:text-zinc-400 mt-2.5 pt-2 border-t border-zinc-100 dark:border-zinc-800/80 leading-relaxed">
                  {award.details}
                </p>
              )}
            </div>
          ))}
        </div>
      </div>

    </div>

  </div>
</section>
