---
import type { PublicationItem } from '../lib/data';

interface Props {
  publications: PublicationItem[];
}

const { publications } = Astro.props;

const categories = ['All', 'Research Article', 'Technical Report', 'Submitted Article'];
---

<section id="publications" class="py-16 md:py-24 border-b border-zinc-200/70 dark:border-zinc-800/70">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-8">
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider text-emerald-700 dark:text-emerald-300 bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200 dark:border-emerald-800">
          Scientific Output
        </div>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-zinc-900 dark:text-white tracking-tight mt-3">
          Publications & Peer-Reviewed Research
        </h2>
        <p class="text-base text-zinc-600 dark:text-zinc-400 mt-2">
          Empirical contributions in climate modeling, multi-model CMIP assessment, bias corrections, and environmental systems.
        </p>
      </div>

      <!-- Filter Tabs -->
      <div class="flex flex-wrap items-center gap-1.5 p-1 rounded-2xl bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 self-start md:self-auto">
        {categories.map((cat, idx) => (
          <button
            type="button"
            data-filter={cat}
            class={`pub-filter-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold transition-all ${
              idx === 0
                ? 'bg-white dark:bg-zinc-800 text-zinc-900 dark:text-white shadow-xs'
                : 'text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white'
            }`}
          >
            {cat}
          </button>
        ))}
      </div>
    </div>

    <!-- Publications List -->
    <div class="space-y-6 mt-4">
      {publications.map((pub) => (
        <article
          data-category={pub.type}
          class="pub-card group relative p-6 sm:p-8 rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200/90 dark:border-zinc-800 hover:border-emerald-500/50 dark:hover:border-emerald-500/50 transition-all duration-300 shadow-xs hover:shadow-xl hover:shadow-emerald-500/5"
        >
          <div class="flex flex-col md:flex-row md:items-start justify-between gap-4">
            
            <!-- Left Info -->
            <div class="space-y-2.5 flex-1">
              
              <!-- Badges Row -->
              <div class="flex flex-wrap items-center gap-2">
                <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/80">
                  {pub.type}
                </span>

                {pub.badge && (
                  <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-cyan-50 dark:bg-cyan-950/60 text-cyan-700 dark:text-cyan-300 border border-cyan-200 dark:border-cyan-800/80">
                    {pub.badge}
                  </span>
                )}

                <span class={`px-2.5 py-0.5 rounded-full text-xs font-semibold ${
                  pub.status === 'Published'
                    ? 'bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300'
                    : 'bg-amber-50 dark:bg-amber-950/60 text-amber-700 dark:text-amber-300 border border-amber-200 dark:border-amber-800/80'
                }`}>
                  {pub.status} · {pub.year}
                </span>
              </div>

              <!-- Title -->
              <h3 class="text-xl sm:text-2xl font-bold text-zinc-900 dark:text-white leading-snug group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
                {pub.doiUrl ? (
                  <a href={pub.doiUrl} target="_blank" rel="noopener noreferrer" class="hover:underline">
                    {pub.title}
                  </a>
                ) : (
                  pub.title
                )}
              </h3>

              <!-- Authors & Journal -->
              <div class="text-sm font-medium text-zinc-700 dark:text-zinc-300">
                <span class="text-zinc-900 dark:text-zinc-100 font-semibold">{pub.authors}</span>
                {pub.journal && (
                  <>
                    <span class="mx-1.5 text-zinc-400 dark:text-zinc-600">•</span>
                    <span class="italic text-emerald-700 dark:text-emerald-400 font-medium">{pub.journal}</span>
                  </>
                )}
              </div>

              <!-- Abstract / Summary -->
              {pub.abstract && (
                <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed pt-1">
                  {pub.abstract}
                </p>
              )}
            </div>

            <!-- Right Actions (DOI & Citation Copy) -->
            <div class="flex flex-row md:flex-col items-center md:items-end gap-2.5 shrink-0 pt-2 md:pt-0">
              {pub.doiUrl && (
                <a
                  href={pub.doiUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-semibold text-white bg-emerald-600 hover:bg-emerald-700 dark:bg-emerald-600 dark:hover:bg-emerald-500 shadow-xs transition-colors"
                >
                  <span>DOI Paper</span>
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </a>
              )}

              <button
                type="button"
                data-citation={`${pub.authors || 'Yazdani, D.'} (${pub.year}). ${pub.title}. ${pub.journal}${pub.doiUrl ? `, ${pub.doiUrl}` : ''}`}
                class="copy-citation-btn inline-flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-medium text-zinc-600 dark:text-zinc-300 bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 transition-colors"
                title="Copy APA Citation"
              >
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                </svg>
                <span class="btn-text">Copy Citation</span>
              </button>
            </div>

          </div>
        </article>
      ))}
    </div>

  </div>
</section>

<script is:inline>
  // Filter functionality
  const filterBtns = document.querySelectorAll('.pub-filter-btn');
  const pubCards = document.querySelectorAll('.pub-card');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-filter');

      // Update button styles
      filterBtns.forEach((b) => {
        b.classList.remove('bg-white', 'dark:bg-zinc-800', 'text-zinc-900', 'dark:text-white', 'shadow-xs');
        b.classList.add('text-zinc-600', 'dark:text-zinc-400');
      });
      btn.classList.add('bg-white', 'dark:bg-zinc-800', 'text-zinc-900', 'dark:text-white', 'shadow-xs');
      btn.classList.remove('text-zinc-600', 'dark:text-zinc-400');

      // Filter cards
      pubCards.forEach((card) => {
        const cat = card.getAttribute('data-category');
        if (filter === 'All' || cat === filter) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });
    });
  });

  // Citation Copy functionality
  document.querySelectorAll('.copy-citation-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const citation = btn.getAttribute('data-citation');
      const textSpan = btn.querySelector('.btn-text');
      if (citation) {
        navigator.clipboard.writeText(citation).then(() => {
          if (textSpan) {
            const original = textSpan.textContent;
            textSpan.textContent = 'Copied!';
            setTimeout(() => {
              textSpan.textContent = original;
            }, 2000);
          }
        });
      }
    });
  });
</script>
