---
import type { CommunityItem } from '../lib/data';

interface Props {
  items: CommunityItem[];
}

const { items } = Astro.props;
---

<section id="community" class="py-16 md:py-24 border-b border-zinc-200/70 dark:border-zinc-800/70">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider text-teal-700 dark:text-teal-300 bg-teal-50 dark:bg-teal-950/60 border border-teal-200 dark:border-teal-800">
        Science Outreach & Creative Engineering
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-zinc-900 dark:text-white tracking-tight mt-3">
        Community Service, Origami & Astronomy
      </h2>
      <p class="text-base text-zinc-600 dark:text-zinc-400 mt-2">
        Exploring the deep intersections between mathematics, origami engineering, space telescope deployable structures, and youth scientific education.
      </p>
    </div>

    <!-- Community Items Grid -->
    <div class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-8">
      {items.map((item) => (
        <div class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200/80 dark:border-zinc-800 shadow-xs hover:border-teal-500/40 transition-colors flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between gap-4 mb-2 pb-3 border-b border-zinc-100 dark:border-zinc-800">
              <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-teal-50 dark:bg-teal-950/70 text-teal-700 dark:text-teal-300 border border-teal-200 dark:border-teal-800">
                {item.category}
              </span>
              <span class="text-xs font-semibold text-zinc-500 dark:text-zinc-400">
                {item.period}
              </span>
            </div>

            <h3 class="text-xl font-bold text-zinc-900 dark:text-white mt-2">
              {item.title}
            </h3>
            
            <p class="text-sm font-semibold text-teal-600 dark:text-teal-400 mt-0.5">
              {item.organization}
            </p>

            <ul class="mt-4 space-y-2">
              {item.highlights.map((bullet) => (
                <li class="flex items-start gap-2.5 text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed">
                  <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-teal-500 shrink-0"></span>
                  <span>{bullet}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
