---
import type { CertificateItem } from '../lib/data';

interface Props {
  certificates: CertificateItem[];
}

const { certificates } = Astro.props;
---

<section id="certificates" class="py-16 md:py-24 border-b border-zinc-200/70 dark:border-zinc-800/70">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider text-emerald-700 dark:text-emerald-300 bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200 dark:border-emerald-800">
        Continuous Learning & Professional Credentials
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-zinc-900 dark:text-white tracking-tight mt-3">
        Specialized Training & Certifications
      </h2>
      <p class="text-base text-zinc-600 dark:text-zinc-400 mt-2">
        International workshops and formal certifications in Earth systems modeling, Copernicus satellite services, machine learning, and environmental sustainability.
      </p>
    </div>

    <!-- Cards Grid -->
    <div class="mt-12 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
      {certificates.map((cert) => (
        <div class="p-5 rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200/80 dark:border-zinc-800 shadow-xs hover:border-emerald-500/40 transition-all duration-200 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class="px-2 py-0.5 rounded-full text-[11px] font-bold bg-emerald-50 dark:bg-emerald-950/70 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/80">
                {cert.category}
              </span>
              <span class="text-[11px] font-semibold text-zinc-500 dark:text-zinc-400">
                {cert.date}
              </span>
            </div>

            <h3 class="text-sm font-bold text-zinc-900 dark:text-white leading-snug">
              {cert.title}
            </h3>
            
            <p class="text-xs text-emerald-600 dark:text-emerald-400 font-semibold mt-2">
              {cert.provider}
            </p>
          </div>

          <div class="mt-4 pt-3 border-t border-zinc-100 dark:border-zinc-800 flex items-center justify-between text-[11px] text-zinc-500 dark:text-zinc-400">
            <span>Status:</span>
            <span class="font-bold text-zinc-800 dark:text-zinc-200">{cert.status}</span>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
